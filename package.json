{
  "name": "teyvat-melody",
  "version": "1.0.24",
  "description": "提瓦特旋律 - 本地音乐播放器（Electron + Python/Flask 混合架构）",
  "main": "electron/main.js",
  "author": "Teyvat Melody",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": ".\\node_modules\\electron\\dist\\electron.exe .",
    "dev:backend": "python electron_backend.py",
    "build:frontend": "cd frontend && npm run build",
    "build": "electron-builder --publish never",
    "lint": "cd frontend && npm run lint",
    "test:js": "node tests/run.js",
    "test:py": "uv run python tests/run.py",
    "test": "npm run test:js && npm run test:py",
    "test:ui": "node tools/ui-e2e.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.teyvat.melody",
    "productName": "TeyvatMelody",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "electron/**",
      "frontend/dist/**",
      "resources/**",
      "!frontend/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/TeyvatMelody.ico",
        "to": "resources/TeyvatMelody.ico"
      }
    ],
    "extraFiles": [
      {
        "from": "resources/app-readme.txt",
        "to": "README.txt"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/TeyvatMelody.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "resources/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "提瓦特旋律 Teyvat Melody"
    }
  }
}
