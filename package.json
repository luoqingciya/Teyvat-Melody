{
  "name": "teyvat-melody",
  "version": "1.1.0",
  "description": "提瓦特旋律 - 本地音乐播放器（Electron + Python/Flask 混合架构）",
  "main": "electron/main.js",
  "author": "Teyvat Melody",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": ".\\node_modules\\electron\\dist\\electron.exe .",
    "dev:backend": "python electron_backend.py",
    "build:frontend": "cd frontend && npm run build",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.teyvat.melody",
    "productName": "TeyvatMelody",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "electron/**",
      "frontend/dist/**",
      "resources/**",
      "!frontend/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/TeyvatMelody.ico",
        "to": "resources/TeyvatMelody.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/TeyvatMelody.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
